{
  "name": "child-games-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:components": "node scripts/test-components.mjs",
    "test:all": "npm test && npm run test:components",
    "standalone": "npm run build && node scripts/standalone.mjs",
    "check": "npm run build && npm run test:all"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "jsdom": "28.1.0",
    "esbuild": "0.27.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
